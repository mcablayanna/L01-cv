    "from sklearn.neighbors import KNeighborsClassifier\n",
    "# warning this takes 4m 15s to run.....\n",
    "# Use the reshaped `X_test` and `y_test` data to create a $k$-nearest neighbor classifier of digit. What is the optimal number of neighbors $k$? If you can't determine this, play around with different values of $k$ for your classifier.\n",
    "ks = np.arange(1, 16, 2) # odd numbers from 1 to 15\n",
    "scores = []\n",
    "for k in ks:\n",
    "    classification_model = KNeighborsClassifier(n_neighbors=k).fit(X, y_train)\n",
    "    scores.append(classification_model.score(X_test, y_test))\n",
    "    print(\"k:\", k, \"score:\", classification_model.score(X_test, y_test))\n",
    "\n",
    "\n",
    "best_k = ks[np.argmax(scores)]\n",
    "print(\"Best k:\", best_k)\n",
    "\n",
    "plt.plot(ks, scores, marker = 'o')\n",
    "plt.xlabel('k')\n",
    "plt.ylabel('Accuracy')\n",
    "plt.show()\n"
   ]
  },
