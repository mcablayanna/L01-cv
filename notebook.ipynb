    "from sklearn.metrics import confusion_matrix, ConfusionMatrixDisplay, classification_report\n",
    "classification_model = KNeighborsClassifier(n_neighbors=best_k).fit(X, y_train) \n",
    "y_pred = classification_model.predict(X_test)\n",
    "\n",
    "print(\"Test Accuracy:\", classification_model.score(X_test, y_test))\n",
    "\n",
    "cm = confusion_matrix(y_test, y_pred)\n",
    "ConfusionMatrixDisplay(cm, display_labels = range(10)).plot(cmap = \"Blues\", values_format = \"d\")\n",
    "plt.show()\n",
    "\n",
    "print(classification_report(y_test, y_pred))\n"
